generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model video {
  VideoId       Int            @id @default(autoincrement())
  Name          String         @db.VarChar(45)
  FolderAddress String         @db.VarChar(150)
  CategoryId    Int?
  StatusId      Int            @default(1)
  CreatedAt     DateTime       @default(now()) @db.DateTime(0)
  UpdatedAt     DateTime?      @db.DateTime(0)
  videocategory videocategory? @relation(fields: [CategoryId], references: [CategoryId], onDelete: NoAction, onUpdate: NoAction, map: "CategoryId")
  videostatus   videostatus    @relation(fields: [StatusId], references: [StatusId], onDelete: NoAction, onUpdate: NoAction, map: "StatusId")

  @@index([CategoryId], map: "CategoryId_idx")
  @@index([StatusId], map: "StatusId_idx")
}

model videocategory {
  CategoryId          Int     @id @default(autoincrement())
  CategoryName        String  @db.VarChar(45)
  CategoryDescription String? @db.VarChar(200)
  video               video[]
}

model videostatus {
  StatusId    Int     @id @default(autoincrement())
  StatusName  String  @db.VarChar(45)
  Description String? @db.VarChar(150)
  video       video[]
}
